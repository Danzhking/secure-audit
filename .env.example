# PostgreSQL
POSTGRES_USER=audit
POSTGRES_PASSWORD=auditpass
POSTGRES_DB=auditdb

# RabbitMQ (логин/пароль для AMQP и веб-интерфейса)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Collector: список API-ключей через запятую и секрет для HMAC
COLLECTOR_API_KEYS=service-key-auth-001,service-key-files-002
COLLECTOR_HMAC_SECRET=super-secret-hmac-key-change-in-production

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# API: секрет подписи JWT (не короче 32 символов)
JWT_SECRET=jwt-secret-change-in-production-must-be-32-chars!
